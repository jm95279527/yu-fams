<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CompanyMapper">

    <sql id="Base_Column_List">
        id,name,sort,remark,create_time as createTime,update_time as updateTime
    </sql>

    <select id="selectAll" resultType="com.example.entity.Company">
        select
        <include refid="Base_Column_List" />
        from company
        <where>
            <if test="name != null and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
        order by sort asc, id asc
    </select>

    <select id="selectById" resultType="com.example.entity.Company">
        select
        <include refid="Base_Column_List" />
        from company
        where id = #{id}
    </select>

    <select id="selectByName" resultType="com.example.entity.Company">
        select
        <include refid="Base_Column_List" />
        from company
        where name = #{name}
        limit 1
    </select>

    <insert id="insert" parameterType="com.example.entity.Company" useGeneratedKeys="true" keyProperty="id">
        insert into company (name, sort, remark, create_time, update_time)
        values (#{name}, #{sort}, #{remark}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateById" parameterType="com.example.entity.Company">
        update company
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = #{updateTime},
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from company where id = #{id}
    </delete>

</mapper>
